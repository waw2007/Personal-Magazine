{
  "name": "personal-magazine-desktop",
  "version": "0.1.0",
  "description": "Personal Magazine 桌面应用（主界面 + 桌面小组件）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dlut.personalmagazine",
    "productName": "Personal Magazine",
    "files": [
      "main.js",
      "preload.js",
      "widget/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "../frontend/dist", "to": "frontend-dist" },
      { "from": "assets/icon.png", "to": "icon.png" }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
